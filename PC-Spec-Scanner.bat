@echo off
setlocal
title PC Benchmark Hub - Hardware Scanner
echo PC Benchmark Hub Windows hardware scanner
echo This is read-only. It collects hardware basics only.
echo It does not collect usernames, serial numbers, IP addresses or personal files.
echo.
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 echo. & echo The scan may not have completed successfully.
echo.
pause
